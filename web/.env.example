# Copy this file to web/.env and fill in your KIE.AI key (never commit .env).
#
# Get your key at https://kie.ai (Dashboard > API Keys).
# The key is used ONLY server-side and is never sent to the browser.

KIE_API_KEY=your_kie_api_key_here

# ── Optional ──────────────────────────────────────────────────────────────
# Override the API host if KIE gives you a dedicated endpoint.
# KIE_BASE_URL=https://api.kie.ai

# Port the local studio server listens on.
# PORT=4321

# ── Competitor "Spy" tab (optional) ────────────────────────────────────────
# Pulls a competitor's live ads from the Meta Ad Library so you can clone them.
# Get a token at https://developers.facebook.com (a User or App access token).
# Without this, generation + "clone by screenshot" still work — only the
# brand-name competitor search is disabled.
# META_ACCESS_TOKEN=your_meta_access_token_here
# META_API_VERSION=v23.0

# ── Publish to Meta (optional) ─────────────────────────────────────────────
# Lets you push a generated/cloned creative straight into your ad account as a
# PAUSED ad (or a reusable ad creative). Needs the ads_management scope on the
# token above, plus the account + page below. Ad set ID is entered in the UI.
# META_AD_ACCOUNT_ID=act_1234567890
# META_PAGE_ID=your_facebook_page_id
# META_IG_USER_ID=your_instagram_user_id     # optional
# META_PIXEL_ID=your_pixel_id                 # optional (adds conversion tracking)

# ── Spy deep-scrape (optional) ─────────────────────────────────────────────
# The "Scrape" button on each ad always extracts follower count, caption, CTA,
# destination link, display format, and all media (no browser needed).
# Set this to true to ALSO attempt engagement counts via a headless browser.
# Requires Playwright: `npm i playwright && npx playwright install chromium`.
# SPY_HEADLESS=false

