# Copy this file to web/.env and fill in your KIE.AI key (never commit .env).
#
# Get your key at https://kie.ai (Dashboard > API Keys).
# The key is used ONLY server-side and is never sent to the browser.

KIE_API_KEY=your_kie_api_key_here

# ── Optional ──────────────────────────────────────────────────────────────
# Override the API host if KIE gives you a dedicated endpoint.
# KIE_BASE_URL=https://api.kie.ai

# Port the local studio server listens on.
# PORT=4321

# ── Competitor "Spy" tab (optional) ────────────────────────────────────────
# Pulls a competitor's live ads from the Meta Ad Library so you can clone them.
# Get a token at https://developers.facebook.com (a User or App access token).
# Without this, generation + "clone by screenshot" still work — only the
# brand-name competitor search is disabled.
# META_ACCESS_TOKEN=your_meta_access_token_here
# META_API_VERSION=v23.0

